{
  "name": "globus-maker",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix FE && npm install",
    "dev": "bash scripts/dev.sh",
    "dev:api": "tsx BE/src/dev-server.ts",
    "dev:fe": "npm run dev --prefix FE",
    "dev:processor": "docker compose up --build processor",
    "dev:cf": "npm run build:fe && npx wrangler dev",
    "build:fe": "npm run build --prefix FE",
    "build": "npm run build:fe",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:worker": "npm run build && npx wrangler deploy --containers-rollout=none",
    "test": "npm run test:be",
    "test:be": "npx tsx BE/tests/tile-math.test.ts && npx tsx BE/tests/map-style.test.ts",
    "typecheck": "tsc --noEmit -p BE/tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.28",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.27",
    "wrangler": "^4.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  }
}
