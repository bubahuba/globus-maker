{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "globus-maker",
  "main": "worker.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "assets": {
    "directory": "./FE/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPA fallback must not swallow API navigations (open image in new tab).
    // true (not only /api/*): asset router still SPA-falls-back navigations to
    // URLs that look like static files (e.g. /api/.../out-04.jpg).
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "globus-maker-artifacts"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GlobusProcessor"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["GlobusProcessor"]
    }
  ],
  // Requires no conflicting A/CNAME for globe on the rgb.sk zone.
  // If deploy fails with 409, delete that DNS record, then redeploy.
  "routes": [
    {
      "pattern": "globe.rgb.sk",
      "custom_domain": true
    }
  ],
  "vars": {
    "PROCESSOR_URL": "https://globus-processor.rascasone.dev",
    "PUBLIC_SITE_ORIGIN": "https://globe.rgb.sk",
    "API_CALLBACK_ORIGIN": "https://globe.rgb.sk",
    "MONITOR_ORIGIN": "https://rgb.sk",
    "PAYPAL_MODE": "live",
    "PAYPAL_CURRENCY": "EUR"
  }
}
