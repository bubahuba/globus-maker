# Local / Docker / API — copy to `.env` for sandbox, `.env.production` for live.
# Never commit real secrets. Client secret must not go into FE/.env*.
#
# Production (Cloudflare):
#   npx wrangler secret put PAYPAL_CLIENT_ID
#   npx wrangler secret put PAYPAL_CLIENT_SECRET
#   npx wrangler secret put PAYPAL_MODE   # value: live
# Optional vars: PAYPAL_CURRENCY, PAYPAL_AMOUNT

# sandbox | live
PAYPAL_MODE=sandbox

# PayPal REST app credentials (Developer Dashboard → Apps & Credentials)
USER_PAYPAL=
PASS_PAYPAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Checkout defaults (globe zip) — amount is enforced server-side
PAYPAL_CURRENCY=EUR
PAYPAL_AMOUNT=5
