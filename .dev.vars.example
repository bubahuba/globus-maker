PROCESSOR_URL=http://localhost:8080
API_CALLBACK_ORIGIN=http://host.docker.internal:8787

# PayPal Checkout (sandbox) — copy values from `.env`
PAYPAL_MODE=sandbox
USER_PAYPAL=
PASS_PAYPAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Amount is diameter-based (€2 at 20 cm → €6 at 60 cm), not a fixed env var.
PAYPAL_CURRENCY=EUR
