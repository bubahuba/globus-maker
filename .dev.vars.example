PROCESSOR_URL=http://localhost:8080
# Must be reachable by the processor so it can PUT preview files + zip.
# Local Docker processor → host.docker.internal; remote processor → public API URL.
API_CALLBACK_ORIGIN=http://host.docker.internal:8787

# Monitor host with PHP /globe-preview list+save (FE /latest-planet archive proxy).
MONITOR_ORIGIN=https://rgb.sk

# PayPal Checkout (sandbox) — copy values from `.env`
PAYPAL_MODE=sandbox
USER_PAYPAL=
PASS_PAYPAL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Amount is diameter-based (€2 at 20 cm → €6 at 60 cm), not a fixed env var.
PAYPAL_CURRENCY=EUR
