# Frontend-only public PayPal Checkout settings (Vite / SvelteKit).
# Client Secret (PASS_PAYPAL) must NEVER be placed here.

PUBLIC_PAYPAL_MODE=sandbox
PUBLIC_PAYPAL_CLIENT_ID=
PUBLIC_PAYPAL_CURRENCY=EUR
# Checkout amount comes from the API (diameter-based: €2–€6).

# Public site origin for Open Graph / canonical URLs (no trailing slash).
# Used at build/prerender time. Defaults to https://globus-maker.shadow-hub.workers.dev
# PUBLIC_SITE_ORIGIN=https://globus-maker.shadow-hub.workers.dev
